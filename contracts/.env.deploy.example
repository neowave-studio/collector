# Deployment environment for `forge script script/Deploy.s.sol:Deploy`.
#
#   cp .env.deploy.example .env.deploy
#   # fill in the blanks, then:
#   set -a && source .env.deploy && set +a
#   forge script script/Deploy.s.sol:Deploy --rpc-url "$RPC_URL" --broadcast --verify
#
# Do NOT commit the filled-in copy. `.env.deploy` is gitignored; `.env.deploy.example` is not.

# --- which chain -------------------------------------------------------------------------------
# Must match a `key` in script/chains.json. The script asserts this against the RPC's chain id, so a
# mismatched RPC fails before anything is deployed rather than half-way through.
CHAIN_KEY=base_sepolia
RPC_URL=https://sepolia.base.org

# --- keys --------------------------------------------------------------------------------------
# Testnet only. For mainnet the deployer should be a hardware wallet or KMS-backed signer — this
# key creates the Timelock and every proxy, so it is briefly the most powerful key in the system.
DEPLOYER_PRIVATE_KEY=

# --- Chainlink VRF -----------------------------------------------------------------------------
# The FULL uint256 from vrf.chain.link — use the copy button next to the ID, do not retype the
# abbreviated "102349...7424" shown in the drawer. A wrong id deploys fine and then every rip
# reverts as an unfunded subscription, which is a confusing way to find a typo.
#
# The subscription must ALSO be funded (Base Sepolia ETH, because chains.json sets
# nativePayment=true for this chain) or requests are accepted and never fulfilled.
VRF_SUBSCRIPTION_ID=

# --- governance --------------------------------------------------------------------------------
# On mainnet SAFE_ADDRESS must be a real multisig: it is the sole proposer and executor on the
# Timelock, and therefore the only thing standing between a stolen ops key and the reserve.
# On a testnet rehearsal a plain EOA you control is fine.
SAFE_ADDRESS=
OPS_ADDRESS=
TREASURY_ADDRESS=
ROYALTY_RECEIVER=

# --- metadata ----------------------------------------------------------------------------------
# Trailing slash matters — token URIs are this concatenated with the token id.
NFT_BASE_URI=https://your-domain.example/api/meta/

# --- testnet only ------------------------------------------------------------------------------
# Shortens the governance delay so a rehearsal does not take two days. IGNORED on any chain not
# marked `testnet: true` in chains.json, where the delay is always 48h. Floor is 60s, so the
# queue -> wait -> execute path is still genuinely exercised rather than skipped.
TIMELOCK_DELAY_SECONDS=60
