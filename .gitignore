# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# dev artifacts
.playwright-mcp/
/screenshots/
/*.png
/*.jpg
.claude/
.mcp.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# `.env*` only matches names that START with `.env`, so it does not cover `be.env`, `fe.env`,
# `prod.env` or anything else of that shape — which is exactly how signing keys get committed.
*.env
# ...but the templates carry no secrets and are useless to a new operator if they are not in the repo.
!.env.example
!**/.env.example
!**/.env.deploy.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend
/backend/node_modules
/backend/dist
/backend/.data

# contracts
/contracts/node_modules
/contracts/lib
/contracts/out
/contracts/cache
/contracts/broadcast

# devnet bookkeeping
/backend/.devnet-funded.json
