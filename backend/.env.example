# =============================================================================================
# Collector backend configuration
#
# NOTHING in here is a signing key in production. `SIGNER_MODE=kms` keeps every private key inside
# AWS KMS / CloudHSM and the process only ever sees signatures (spec §8.6). `SIGNER_MODE=local` exists
# for local development and CI only; `config.ts` refuses to start with local keys when NODE_ENV is
# production.
# =============================================================================================

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
PUBLIC_ORIGIN=http://localhost:3000

# --- storage ---------------------------------------------------------------------------------
DATABASE_URL=postgres://collector:collector@localhost:5432/collector
REDIS_URL=redis://localhost:6379

# --- sessions (SIWE) -------------------------------------------------------------------------
SESSION_SECRET=change-me-32-bytes-minimum-for-hmac-signing
SESSION_TTL_SECONDS=3600
SIWE_NONCE_TTL_SECONDS=300

# --- signing ---------------------------------------------------------------------------------
# local | kms
SIGNER_MODE=local
# Only read when SIGNER_MODE=local. Never set these in production.
ORACLE_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
RELAYER_PRIVATE_KEY=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba
BUYBACK_PRIVATE_KEY=0x92db14e403b83dfe3df233f83dfa3a0d7096f21ca9b0d6d6b8d88b2b4ec1564e
POOL_AUTHOR_PRIVATE_KEY=0x4bbbf85ce3377467afe5d46f804f221813b2bb87f24d81f60f1fcdbf7cbf4356

# Only read when SIGNER_MODE=kms.
KMS_ORACLE_KEY_ID=
KMS_RELAYER_KEY_ID=
KMS_BUYBACK_KEY_ID=
KMS_POOL_AUTHOR_KEY_ID=
AWS_REGION=us-east-1

# --- chains ----------------------------------------------------------------------------------
# Comma-separated keys from contracts/script/chains.json that this deployment serves.
ENABLED_CHAINS=base_sepolia
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Public Sepolia endpoints are heavily rate limited and will stall the indexer. Use Alchemy/Infura.
ETHEREUM_SEPOLIA_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BNB_RPC_URL=
ETHEREUM_RPC_URL=
ROBINHOOD_RPC_URL=

# --- MoonPay ---------------------------------------------------------------------------------
MOONPAY_API_KEY=pk_test_xxx
MOONPAY_SECRET_KEY=sk_test_xxx
MOONPAY_WEBHOOK_SECRET=whsec_xxx
MOONPAY_WIDGET_BASE=https://buy-sandbox.moonpay.com
# Days a fiat-funded asset stays non-transferable / non-cashable while the card payment is still
# reversible (spec §9 FIX C4-backend). 120 covers the common Visa/Mastercard dispute windows.
FIAT_CHARGEBACK_HOLDBACK_DAYS=120

# --- compliance (spec §12) -------------------------------------------------------------------
# How hard the money-action gate is. The requirement is driven by the PRODUCT SHAPE, not the payment
# rail: what creates it is "pay money -> random outcome -> WE pay cash back out". Remove that last
# leg and the posture changes.
#
#   full      Sell-back is live. Document KYC + verified jurisdiction + age + a cash-out tier.
#   age_only  No sell-back; users keep, redeem, or trade peer-to-peer. Self-attested age + IP
#             jurisdiction. This is the ordinary sealed-pack retail posture.
#   off       No gate. TESTNET ONLY. The backend refuses to start with this set when NODE_ENV is
#             production OR when any enabled chain is a mainnet. Self-exclusion is still honoured.
COMPLIANCE_MODE=off

# ISO-3166 alpha-2 codes where paid draws are NOT offered. This list is a placeholder: it MUST be set
# by counsel per market before launch, not by engineering.
GACHA_BLOCKED_JURISDICTIONS=US-WA,US-HI,BE,NL,JP-restricted,AU
MIN_AGE_YEARS=18
# Fail closed: if the KYC provider is unreachable, refuse the money action rather than allow it.
KYC_PROVIDER_URL=
KYC_PROVIDER_API_KEY=

# --- publishing ------------------------------------------------------------------------------
# Pool files are pinned to >= 2 IPFS services + Arweave (spec §8.2). Comma-separated endpoints.
IPFS_PIN_ENDPOINTS=
ARWEAVE_GATEWAY=https://arweave.net
PROOF_TOOL_URL=https://collector-cards.com/verify

# --- ops -------------------------------------------------------------------------------------
RECONCILER_INTERVAL_MS=30000
INDEXER_INTERVAL_MS=5000
# When the chain and the DB disagree about reserve state, buyback auto-pauses (spec §8.3).
RECONCILER_AUTOPAUSE=true
ALERT_WEBHOOK_URL=
